# Copy to .env and change every value marked CHANGE_ME.  `.env` is git-ignored.

# --- General ----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
COMPOSE_PROJECT_NAME=eujobs

# --- Host ports (change if they clash with other local stacks) ---------------
API_PORT=8081
POSTGRES_PORT=5433
REDIS_PORT=6380

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=eujobs
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=eujobs
# Used by processes on the host (tests, alembic). Containers get their own URL in compose.
DATABASE_URL=postgresql+asyncpg://eujobs:CHANGE_ME_postgres_password@localhost:5433/eujobs

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@localhost:6380/0

# --- API security -------------------------------------------------------------
# Comma-separated. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=CHANGE_ME_api_key
CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_DEFAULT=120/minute
MAX_UPLOAD_MB=10

# --- LLM (Ollama) -------------------------------------------------------------
# Native Ollama on macOS (recommended on Apple Silicon): http://host.docker.internal:11434
# Containerised Ollama (docker compose --profile ollama): http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_CHAT_MODEL=llama3.2:3b
LLM_EMBEDDING_MODEL=nomic-embed-text

# --- Discovery ----------------------------------------------------------------
JOB_EXPIRY_DAYS=21
